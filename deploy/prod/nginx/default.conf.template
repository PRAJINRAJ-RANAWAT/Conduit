# NGINX: TLS termination + load balancing across the two gateways. ${DOMAIN} is filled in by the nginx image.
# NOTE: nginx looks up container IPs when it starts/reloads, so deploy.sh reloads it after restarting a gateway.
upstream gateways {
  server gateway-1:8080 max_fails=1 fail_timeout=2s;
  server gateway-2:8080 max_fails=1 fail_timeout=2s;
  keepalive 32;
}

server {                                   # plain HTTP: Let's Encrypt challenge + redirect to HTTPS
  listen 80;
  server_name ${DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};
  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  client_max_body_size 1m;

  location ~ ^/(v1|jobs|prompts|stats|admin|healthz|readyz)(/|$) {     # the API
    proxy_pass http://gateways;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
  }
  location / {                                                          # the web UI
    proxy_pass http://web:3000;
    proxy_set_header Host $host;
  }
}
